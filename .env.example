# --- services crate (thin backend: Paystack webhooks, etc.) ---
# Direct Postgres connection to your Supabase project (Settings > Database
# > Connection string > URI). Connects as a role that bypasses RLS.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
BIND_ADDR=0.0.0.0:8080
RUST_LOG=services=debug,tower_http=debug
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- frontend crate (baked into the WASM bundle at build time) ---
# Public by design — see crates/frontend/src/supabase/config.rs. Set these
# as real environment variables before `trunk build`/`trunk serve`
# (Vercel project settings for deploys; your shell for local dev).
# Local values below match `supabase start`'s default local stack.
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-your-project-anon-key
