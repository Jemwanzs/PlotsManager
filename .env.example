# --- backend crate (crates/backend) ---
# Railway Postgres connection string (Railway dashboard > Postgres plugin
# > "Connect" tab, or the auto-injected DATABASE_URL if the backend
# service and Postgres plugin share a Railway project/environment).
# Local dev: use a dedicated database name (not the default "postgres"
# db, which may be shared with other local projects), and prefer
# 127.0.0.1 over "localhost" — on a machine with a native Postgres
# service already running on port 5432 (e.g. a Windows Postgres install),
# "localhost" can resolve to ::1 and silently hit that service instead of
# a Docker container you meant to use, even though both "work". See
# database/README.md.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/real_estate_manager
# Railway injects PORT automatically in deployed environments; BIND_ADDR
# is the local-dev fallback (see crates/backend/src/main.rs).
BIND_ADDR=0.0.0.0:8080
RUST_LOG=backend=debug,tower_http=debug
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signs session tokens issued by crates/backend/src/auth.rs. Generate a
# real random value per environment (e.g. `openssl rand -hex 32`) — never
# reuse the example below outside local dev.
JWT_SECRET=dev-only-secret-change-me

# --- frontend crate (crates/frontend) ---
# Base URL of the backend API, read at compile time by
# crates/frontend/src/app.rs (Trunk shells out to `cargo build`, so this
# needs to be set in the shell/CI environment before `trunk serve` or
# `trunk build`, not just in this .env file — dotenvy is only loaded by
# the backend). Unset: the app runs against crates/frontend/src/api/mock
# instead, no backend required, for frontend-only work.
API_BASE_URL=http://localhost:8095
