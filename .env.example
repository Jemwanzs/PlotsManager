# --- backend crate (crates/backend) ---
# Railway Postgres connection string (Railway dashboard > Postgres plugin
# > "Connect" tab, or the auto-injected DATABASE_URL if the backend
# service and Postgres plugin share a Railway project/environment).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Railway injects PORT automatically in deployed environments; BIND_ADDR
# is the local-dev fallback (see crates/backend/src/main.rs).
BIND_ADDR=0.0.0.0:8080
RUST_LOG=backend=debug,tower_http=debug
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Signs session tokens issued by crates/backend/src/auth.rs. Generate a
# real random value per environment (e.g. `openssl rand -hex 32`) — never
# reuse the example below outside local dev.
JWT_SECRET=dev-only-secret-change-me

# --- frontend crate (crates/frontend) ---
# Base URL of the deployed backend API. Only consumed once
# crates/frontend/src/api/http.rs is actually wired up (see
# docs/14-development-roadmap.md) — the app runs against api::mock until
# then, so this isn't required for local frontend-only development.
API_BASE_URL=http://localhost:8080
