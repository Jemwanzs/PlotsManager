server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Leptos client-side routing (leptos_router history-API paths like
    # /projects, /customers/{id}) — a direct load or refresh on one of
    # those needs to fall back to index.html so the SPA can take over.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /health {
        add_header Content-Type text/plain;
        return 200 'ok';
    }
}
